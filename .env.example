# Spotify on the home page. Without these the music readout and menu stay hidden.
# GitHub stats come from public pages and need no key.
# Docker deploys read /home/pascal/.config/website/stats.env; `bun run dev` reads .env.local.

# Spotify app from developer.spotify.com (the owner needs Premium); get the
# refresh token with `bun scripts/spotify-token.ts`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Trips: the website's own Postgres database. Docker deploys read
# /home/pascal/.config/website/db-<target>.env (made by server-infra's
# postgres/databases.sh) and trips-<target>.env for the sign-in secrets.
DATABASE_URL=
# Google sign-in for the private trips. Without GOOGLE_CLIENT_ID, `bun run dev`
# is signed in as Dev.
APP_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
