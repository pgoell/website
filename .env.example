# Spotify on the home page. Without these the music readout and menu stay hidden.
# GitHub stats come from public pages and need no key.
# Docker deploys read /home/pascal/.config/website/stats.env; `bun run dev` reads .env.local.

# Spotify app from developer.spotify.com (the owner needs Premium); get the
# refresh token with `bun scripts/spotify-token.ts`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
