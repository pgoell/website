# Live stats on the home page. Without them the page shows sample data.
# Docker deploys read /home/pascal/.config/website/stats.env; `bun run dev` reads .env.local.

# Fine-grained GitHub token, public repositories read-only, no extra permissions.
GITHUB_TOKEN=

# Spotify app from developer.spotify.com; get the refresh token with
# `bun scripts/spotify-token.ts`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
